# من إعدادات المشروع في Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# مفتاح service_role — سري تمامًا، يتجاوز RLS، لا تشاركه ولا تحطه في كود
# الواجهة الأمامية. يُستخدم فقط داخل Server Actions في لوحة التحكم.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# التوكن السري لدخول لوحة التحكم: /admin/<هذا-التوكن>
# ولّد قيمة عشوائية طويلة، مثلاً بالأمر:
#   openssl rand -hex 32
ADMIN_ACCESS_TOKEN=change-me-to-a-long-random-value
