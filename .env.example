# من إعدادات المشروع في Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# مفتاح service_role — سري تمامًا، يتجاوز RLS، لا تشاركه ولا تحطه في كود
# الواجهة الأمامية. يُستخدم فقط داخل Server Actions في لوحة التحكم.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# قائمة الإيميلات المسموح لها تدخل لوحة التحكم (مفصولة بفاصلة). أي حساب
# غير موجود هنا يُرفض حتى لو نجح تسجيل الدخول في Supabase Auth.
ADMIN_ALLOWED_EMAILS=admin1@example.com,admin2@example.com
